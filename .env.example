NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-64-character-random-secret-before-use
JWT_ISSUER=ci360-realtime-app
JWT_AUDIENCE=ci360-dashboard
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=7
DATABASE_PATH=./data/ci360.db
UPLOAD_DIR=./data/private-uploads
MAX_UPLOAD_MB=10
TRUST_PROXY=false
LOG_LEVEL=info

# Current implementation uses SQLite. Configure and implement these before switching to MySQL:
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
