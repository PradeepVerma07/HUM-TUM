{
  "name": "ci360-realtime-job-board",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client && node -e \"const fs=require('fs'); try{fs.mkdirSync('server/dist/public', {recursive:true}); fs.cpSync('client/dist', 'server/dist/public', {recursive:true});}catch(e){}\"",
    "start": "node server/dist/index.js",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "create-admin": "npm run create-admin -w server",
    "seed:demo": "npm run seed:demo -w server",
    "migrate": "npm run migrate -w server",
    "migrate:status": "npm run migrate:status -w server",
    "lint": "npm run lint -w server && npm run lint -w client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w server",
    "test:integration": "npm run test:integration -w server",
    "test:e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
